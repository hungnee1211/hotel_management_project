# Leave VITE_API_URL empty in development: Vite proxies /api to the backend so cookies stay same-origin.
# VITE_API_URL=https://api.example.com/api   (only for a cross-site deployment: needs COOKIE_SAME_SITE=none + CLIENT_URL on the backend)
VITE_API_PROXY=http://localhost:5000
VITE_DEFAULT_CURRENCY=VND
VITE_HOTEL_TZ=Asia/Ho_Chi_Minh
